<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="fr3">

    <!-- xacro includes -->
    <xacro:include filename="$(find franka_description)/mjcf/robots/common/franka_multi_robot.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/robots/common/franka_robot.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/robots/common/franka_arm.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/robots/common/franka_arm_actuator.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/end_effectors/common/franka_hand.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/end_effectors/common/ee_with_one_link.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/end_effectors/common/franka_hand_actuator.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/robots/fr3/assets.xml.xacro" />
    <xacro:include filename="$(find franka_description)/mjcf/end_effectors/franka_hand/assets.xml.xacro" />

    <!-- base xacro includes -->
    <xacro:include filename="$(find husky_description)/mjcf/husky_macro.xml.xacro" />
    <xacro:include filename="$(find husky_description)/mjcf/assets.xml.xacro" />
    <xacro:include filename="$(find fr3_husky_description)/mjcf/box_base.xml.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/mjcf/assets/roas_structure_assets.xml.xacro"/>
    
    <!-- camera xacro includes -->
    <xacro:include filename="$(find fr3_husky_description)/mjcf/realsense_d435i.xml.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/mjcf/azure_kinect.xml.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/mjcf/assets/d435i_assets.xml.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/mjcf/assets/azure_kinect_assets.xml.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/mjcf/plate_ee.xml.xacro"/>

    <!-- ============================================================= -->
    <!-- Should an end-effector be mounted at the flange? -->
    <xacro:arg name="hand" default="true" />

    <!-- Is base husky or just box-shaped? -->
    <xacro:arg name="mobile" default="false"/>

    <!-- Attach RealSense D435i to both EEs? -->
    <xacro:arg name="with_realsense" default="true"/>

    <!-- Attach Azure Kinect to mobile base? -->
    <xacro:arg name="with_azure" default="true"/>

    <!-- RealSense D435i resolution -->
    <xacro:arg name="d435i_color_width"  default="1280"/>
    <xacro:arg name="d435i_color_height" default="720"/>
    <xacro:arg name="d435i_depth_width"  default="848"/>
    <xacro:arg name="d435i_depth_height" default="480"/>

    <!-- Azure Kinect DK resolution -->
    <xacro:arg name="azure_color_width"  default="1920"/>
    <xacro:arg name="azure_color_height" default="1080"/>
    <xacro:arg name="azure_depth_width"  default="640"/>
    <xacro:arg name="azure_depth_height" default="576"/>

    <!-- Box-lift validation. Defaults keep the Reach scene unchanged.
         gravity_z: robot bodies are gravcomp="1", so gravity only acts on free objects (the box).
         mobile_mount_z: arm mount plane (`base`) above Husky base_link; 0.26 puts it 0.392 m
           above the floor, 0.2727 reproduces the 0.405 m of the Isaac training scene.
         box_*: free 410 x 310 x 280 mm box resting on the floor, pose given in `base` (x, y, yaw).
           MuJoCo uses the larger friction of a geom pair, so plate_friction should not exceed
           box_friction when sweeping box friction.
         contact_timeconst: solref time constant of the box and plate geoms (MuJoCo default 0.02 s;
           smaller = stiffer contact, keep >= 2 x timestep). Both get it because MuJoCo mixes the pair. -->
    <xacro:arg name="gravity_z" default="0"/>
    <xacro:arg name="mobile_mount_z" default="0.26"/>
    <xacro:arg name="with_box" default="false"/>
    <xacro:arg name="box_x" default="0.485"/>
    <xacro:arg name="box_y" default="0.0"/>
    <xacro:arg name="box_yaw" default="0.0"/>
    <xacro:arg name="box_mass" default="0.5"/>
    <xacro:arg name="box_friction" default="0.8"/>
    <xacro:arg name="box_condim" default="4"/>
    <xacro:arg name="plate_friction" default="1"/>
    <xacro:arg name="contact_timeconst" default="0.02"/>
    <!-- ============================================================= -->

    <xacro:arg name="arm_id" default="fr3" />
    <xacro:property name="arm_ids_str" value="fr3 fr3" />
    <xacro:property name="robot_prefixes_list" value="${['left','right']}" />
    <xacro:property name="robot_prefixes_str" value="${' '.join(robot_prefixes_list)}" />

    <!-- `base` (arm mount midpoint) ahead of Husky base_link on the mobile scene. -->
    <xacro:property name="mobile_base_x" value="0.345"/>

    <xacro:property name="xyzs_str"
                    value="${'0.345 0.215 0.26;0.345 -0.215 0.26' if '$(arg mobile)' == 'true' else '0 0.34 0.715;0 -0.34 0.715'}" />
    <xacro:property name="rpys_str"
                    value="${'0 0 0.523598776;0 0 -0.523598776' if '$(arg mobile)' == 'true' else '0 0 0;0 0 0'}" />

    <xacro:arg name="control_mode" default="effort" />

    <!-- Reach dynamics ablation parameters. The launch file generates the
         dynamics YAML for all seven joints; physics timestep remains 1 ms. -->
    <xacro:arg name="fr3_armature" default="0.1" />
    <xacro:arg name="fr3_dynamics_path"
               default="$(find franka_description)/mjcf/robots/fr3/dynamics.yaml" />

    <!-- Keep the factory FR3 link inertias for both hand configurations.
         With hand=false, plate_ee_mjcf adds the measured plate inertia as a
         fixed link8 child rather than replacing link7 with a hand-derived
         effective inertia. -->
    <xacro:property name="standard_fr3_inertials"
                    value="${xacro.load_yaml('$(find franka_description)/mjcf/robots/fr3/inertials.yaml')}" />

    <xacro:property name="ee2cam_left_tf"
                    value="${xacro.load_yaml('$(find fr3_husky_description)/config/TF_ee2cam_left.yaml')}" />
    <xacro:property name="ee2cam_right_tf"
                    value="${xacro.load_yaml('$(find fr3_husky_description)/config/TF_ee2cam_right.yaml')}" />
    <xacro:property name="base2cam_tf"
                    value="${xacro.load_yaml('$(find fr3_husky_description)/config/TF_base2cam.yaml')}" />

    <xacro:macro name="dual_fr3_arm"
                 params="arm_prefix connected_to xyz rpy ee2cam_tf">
        <xacro:franka_robot
            arm_id="$(arg arm_id)"
            arm_prefix="${arm_prefix}"
            no_prefix="false"
            connected_to="${connected_to}"
            xyz="${xyz}"
            rpy="${rpy}"
            joint_limits="${xacro.load_yaml('$(find franka_description)/mjcf/robots/fr3/joint_limits.yaml')}"
            kinematics="${xacro.load_yaml('$(find franka_description)/mjcf/robots/fr3/kinematics.yaml')}"
            inertials="${standard_fr3_inertials}"
            dynamics="${xacro.load_yaml('$(arg fr3_dynamics_path)')}"
            accelerometer_config="${xacro.load_yaml('$(find franka_description)/mjcf/robots/fr3/accelerometers.yaml')}"
            hand="$(arg hand)"
            ee_id="franka_hand"
            xyz_ee="0 0 0"
            rpy_ee="0 0 ${-pi/4}"
            tcp_xyz="0 0 0.1034"
            tcp_rpy="0 0 0"
            link0_vis_mesh_indices="[0,1,2,3,4,5,6]"
            link1_vis_mesh_indices="[0]"
            link2_vis_mesh_indices="[0]"
            link3_vis_mesh_indices="[0,1]"
            link4_vis_mesh_indices="[0,1]"
            link5_vis_mesh_indices="[0,1,2]"
            link6_vis_mesh_indices="[0,1,2,3,4,5,6,7]"
            link7_vis_mesh_indices="[0,1,2,3]"
            link0_vis_mesh_materials="['black','white','white','white','white','red','black']"
            link1_vis_mesh_materials="['white']"
            link2_vis_mesh_materials="['white']"
            link3_vis_mesh_materials="['white','black']"
            link4_vis_mesh_materials="['white','black']"
            link5_vis_mesh_materials="['white','white','black']"
            link6_vis_mesh_materials="['button_green','white','white','gray','button_red','white','black','button_blue']"
            link7_vis_mesh_materials="['black','white','white','black']"
            hand_vis_mesh_indices="[0,1,2,3,4]"
            finger_vis_mesh_indices="[0,1]"
            hand_vis_mesh_materials="['off_white','black','black','white','off_white']"
            finger_vis_mesh_materials="['off_white','black']">
            <cam_body>
                <xacro:unless value="$(arg hand)">
                    <xacro:plate_ee_mjcf prefix="${arm_prefix}_fr3"
                                         friction="$(arg plate_friction) 0.005 0.0001"
                                         solref="$(arg contact_timeconst) 1"/>
                </xacro:unless>
                <xacro:if value="$(arg with_realsense)">
                    <xacro:realsense_d435i_mjcf prefix="${arm_prefix}" ee2cam_tf="${ee2cam_tf}"
                        color_width="$(arg d435i_color_width)"
                        color_height="$(arg d435i_color_height)"
                        depth_width="$(arg d435i_depth_width)"
                        depth_height="$(arg d435i_depth_height)"/>
                </xacro:if>
            </cam_body>
        </xacro:franka_robot>
    </xacro:macro>

    <!-- ── Compiler ── -->
    <compiler angle="radian" autolimits="true" />

    <!-- ── Option ── -->
    <!-- Match dual_fr3_lab Reach v2, where gravity is disabled for the robot.
         Box lift sets gravity_z:=-9.81; the robot stays gravity-compensated (gravcomp). -->
    <option timestep="0.001" integrator="implicitfast" gravity="0 0 $(arg gravity_z)" />

    <!-- ── Visual ── -->
    <visual>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="150" elevation="-20" />
    </visual>

    <!-- Default classes -->
    <default>
        <default class="$(arg arm_id)">
            <joint armature="$(arg fr3_armature)" damping="1"/>
            <position inheritrange="1"/>
            <default class="visual">
                <geom type="mesh" group="2" contype="0" conaffinity="0"/>
            </default>
            <default class="finger">
                <joint axis="0 1 0" type="slide" range="0 0.04"/>
            </default>
            <default class="collision">
                <geom type="mesh" group="3" mass="0" density="0"/>
            </default>
            <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
        </default>
        <default class="husky">
            <material specular="0.5" shininess="0.25"/>
            <joint armature="0.1" damping="1"/>
            <position inheritrange="1"/>
            <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
        </default>
    </default>

    <!-- ── Assets ── -->
    <asset>
        <!-- textures / ground material -->
        <texture type="skybox"  builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
                 width="300" height="300" mark="edge" markrgb="0.8 0.8 0.8" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />

        <xacro:fr3_assets arm_id="$(arg arm_id)"/>
        <xacro:franka_hand_assets/>
        <xacro:husky_assets/>
        <xacro:roas_structure_assets/>
        <xacro:plate_ee_mjcf_assets/>
        <xacro:if value="$(arg with_realsense)">
            <xacro:d435i_assets/>
        </xacro:if>
        <xacro:if value="$(arg with_azure)">
            <xacro:azure_kinect_assets/>
        </xacro:if>
    </asset>

    <!-- ── Worldbody ── -->
    <worldbody>
        <!-- ground plane -->
        <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" />

        <!-- Movable, non-colliding reach markers. MujocoWorldSingleton updates
             these mocap bodies from /reach_target_pose (expressed in `base`). -->
        <body name="reach_target_center" mocap="true" pos="0.5 0.0 0.2">
            <geom type="sphere" size="0.025" rgba="0.95 0.95 0.95 0.9"
                  contype="0" conaffinity="0" group="0" />
        </body>
        <body name="reach_target_left" mocap="true" pos="0.5 0.2 0.2">
            <geom type="sphere" size="0.035" rgba="0.1 0.4 1.0 0.9"
                  contype="0" conaffinity="0" group="0" />
        </body>
        <body name="reach_target_right" mocap="true" pos="0.5 -0.2 0.2">
            <geom type="sphere" size="0.035" rgba="1.0 0.3 0.1 0.9"
                  contype="0" conaffinity="0" group="0" />
        </body>

        <!-- Base selection -->
        <xacro:if value="$(arg mobile)">
            <xacro:husky prefix="" as_two_wheels="false">
                <additional_comp>
                    <!-- ROS robot-root frame. In the URDF this frame is named
                         `base`; mobile_base/base_link is offset from it by
                         [-0.345, 0, -mobile_mount_z]. -->
                    <body name="base" pos="${mobile_base_x} 0 $(arg mobile_mount_z)"/>
                    <body name="top_structure_link" pos="0 0 0.248">
                        <inertial pos="-0.108 0 0.252" mass="36.436" fullinertia="6.35 7.648 3.775 0.001 1.711 -0.004" />
                        <geom class="visual" pos="0 0 0" type="mesh" mesh="ROAS_structure" rgba="0.231 0.231 0.231 1.0"/>
                        <geom class="collision" pos="0 0 0.006" type="box" size="${0.90/2} ${0.65/2} ${0.012/2}" />
                        <geom class="collision" pos="-0.28 0 0.65" type="box" size="${0.32/2} ${0.56/2} ${1.3/2}" />
                    </body>
                    
                    <xacro:dual_fr3_arm arm_prefix="left"
                                        connected_to="left_tmp_base"
                                        xyz="${mobile_base_x} 0.215 $(arg mobile_mount_z)"
                                        rpy="0 0 0.523598776"
                                        ee2cam_tf="${ee2cam_left_tf}"/>
                    <xacro:dual_fr3_arm arm_prefix="right"
                                        connected_to="right_tmp_base"
                                        xyz="${mobile_base_x} -0.215 $(arg mobile_mount_z)"
                                        rpy="0 0 -0.523598776"
                                        ee2cam_tf="${ee2cam_right_tf}"/>

                    <xacro:if value="$(arg with_azure)">
                        <xacro:azure_kinect_mjcf prefix="top" base2cam_tf="${base2cam_tf}"
                            color_width="$(arg azure_color_width)"
                            color_height="$(arg azure_color_height)"
                            depth_width="$(arg azure_depth_width)"
                            depth_height="$(arg azure_depth_height)"/>
                    </xacro:if>

                </additional_comp>
            </xacro:husky>

            <!-- Box-lift object. Husky base_link sits at the world x/y origin, so `base` is at
                 world x = mobile_base_x; the box rests on the floor (z = half height). -->
            <xacro:if value="$(arg with_box)">
                <body name="box" pos="${mobile_base_x + $(arg box_x)} $(arg box_y) 0.14"
                      euler="0 0 $(arg box_yaw)">
                    <freejoint name="box_freejoint"/>
                    <geom name="box_geom" type="box" size="0.205 0.155 0.14"
                          mass="$(arg box_mass)" friction="$(arg box_friction) 0.005 0.0001"
                          condim="$(arg box_condim)" solref="$(arg contact_timeconst) 1"
                          rgba="0.80 0.66 0.45 1.0"/>
                </body>
            </xacro:if>
        </xacro:if>


        <xacro:unless value="$(arg mobile)">
            <body name="base" pos="0 0 0">
                <xacro:box_base no_prefix="false" base_prefix="left_" xyz="0 0.34 0.35"/>
                <xacro:box_base no_prefix="false" base_prefix="right_" xyz="0 -0.34 0.35"/>
                    <xacro:dual_fr3_arm arm_prefix="left"
                                        connected_to="left_tmp_base"
                                        xyz="0 0.34 0.715"
                                        rpy="0 0 0"
                                        ee2cam_tf="${ee2cam_left_tf}"/>
                    <xacro:dual_fr3_arm arm_prefix="right"
                                        connected_to="right_tmp_base"
                                        xyz="0 -0.34 0.715"
                                        rpy="0 0 0"
                                        ee2cam_tf="${ee2cam_right_tf}"/>
            </body>
        </xacro:unless>

    </worldbody>

    <!-- Arm actuators (left + right) -->
    <xacro:franka_arm_actuator arm_id="$(arg arm_id)" arm_prefix="left" no_prefix="false" control_mode="$(arg control_mode)" />
    <xacro:franka_arm_actuator arm_id="$(arg arm_id)" arm_prefix="right" no_prefix="false" control_mode="$(arg control_mode)" />

    <!-- Hand actuators (left + right) -->
    <xacro:if value="${'$(arg hand)' == 'true'}">
        <xacro:franka_hand_actuator arm_id="$(arg arm_id)" arm_prefix="left" />
        <xacro:franka_hand_actuator arm_id="$(arg arm_id)" arm_prefix="right" />
    </xacro:if>

</mujoco>
