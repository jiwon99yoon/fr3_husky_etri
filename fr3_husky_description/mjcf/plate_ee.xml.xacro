<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Shared asset declaration for the two plate end-effectors. -->
    <xacro:macro name="plate_ee_mjcf_assets" params="">
        <mesh name="plate_ee_140x140x25"
              file="$(find fr3_husky_description)/meshes/plate_ee_140x140x25.stl"
              scale="0.001 0.001 0.001"/>
    </xacro:macro>

    <!--
      A fixed child of FR3 link8.  Keep the standard FR3 link7 inertia intact
      and represent the measured physical plate assembly independently.  The
      132.4 g assembly is approximated as a uniform 140 x 140 x 25 mm box.
    -->
    <!-- gravcomp="1" like the FR3 links: gravity acts only on free objects
         (no effect while the scene gravity is zero). -->
    <xacro:macro name="plate_ee_mjcf" params="prefix friction:='1 0.005 0.0001' solref:='0.02 1'">
        <body name="${prefix}_plate_ee" euler="0 0 ${3.0 * pi / 4.0}" gravcomp="1">
            <!-- COM at the geometric centre, measured from the flange face. -->
            <inertial pos="0 0 0.0125"
                      mass="0.1324"
                      diaginertia="0.0002231492 0.0002231492 0.0004325067"/>
            <geom name="${prefix}_plate_ee_visual"
                  class="visual"
                  type="mesh"
                  mesh="plate_ee_140x140x25"
                  rgba="0.72 0.74 0.78 1.0"
                  mass="0" density="0"/>
            <geom name="${prefix}_plate_ee_collision"
                  class="collision"
                  type="box"
                  pos="0 0 0.0125"
                  size="0.07 0.07 0.0125"
                  friction="${friction}"
                  solref="${solref}"
                  mass="0" density="0"/>
            <site name="${prefix}_plate_ee_tcp" pos="0 0 0.025"/>
        </body>
    </xacro:macro>
</mujoco>
